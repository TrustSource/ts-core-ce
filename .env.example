# TrustSource CE - reference environment
#
# Copy to `.env` next to docker-compose.yml; Docker Compose reads it automatically.
# `.env` is gitignored, this file is not - never put a real credential here.
#
# The five REQUIRED settings have no default and the stack refuses to start
# without them. Everything below them is optional.

# --- Required ------------------------------------------------------------

# Password for the MongoDB root user the compose file creates.
MONGO_ROOT_PASSWORD=

# Password for the MongoDB user the app connects with (read/write on its own
# database only). Both MongoDB users are created when the database volume is
# first created; changing these later has no effect on an existing volume.
MONGO_APP_PASSWORD=

# The first administrator, created on an empty database at first start.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=


# Encrypts integration credentials at rest. Changing it after data exists makes
# every stored secret unreadable unless the old value is kept in
# TS_ENCRYPTION_KEY_PREVIOUS (see "Key rotation" below), so keep it safe.
TS_ENCRYPTION_KEY=

# --- Optional ------------------------------------------------------------

# MongoDB root user name. Default: admin
#MONGO_ROOT_USERNAME=admin

# MongoDB user name the app connects with. Default: trustsource
#MONGO_APP_USERNAME=trustsource

# Address the app's port 3000 is published on. The default keeps it local, for a
# TLS reverse proxy on the same host; 0.0.0.0 publishes it on every interface.
# Default: 127.0.0.1
#TS_BIND_ADDRESS=127.0.0.1

# Public URL of the installation. Links in outgoing mail are built from it, so
# set it to the address users actually reach. Default: http://localhost:3000/
#ROOT_URL=http://localhost:3000/

# Further origins (comma-separated, e.g. https://ts.internal.example) users may
# open the app from. Live updates are refused from any origin other than ROOT_URL
# and these. Default: none
#TS_ALLOWED_DDP_ORIGINS=

# Number of reverse proxies (TLS terminator, load balancer) in front of the app.
# With a proxy, set it to 1 (one per proxy hop), so the client IP is read from
# X-Forwarded-For. Otherwise every user appears to come from the proxy's address
# and they share the per-IP sign-in rate limits and login history entries.
# Never set it higher than the real number of proxies: a client could then forge
# its address. Default: 0 (the app is reached directly)
#HTTP_FORWARDED_COUNT=0

# How many module analyses run at the same time. Default: 2
#TS_ANALYSIS_CONCURRENCY=2

# Outgoing mail. The compose file ships a Mailpit catcher on smtp://mailpit:1025
# and shows the messages at http://localhost:8025 - replace both for real mail.
#MAIL_URL=smtp://user:password@smtp.example.com:587
#MAIL_SENDER=noreply@example.com

# Operator details for the footer of outgoing mails; each line appears only when
# set. The support address is also whom account mails tell an unexpected
# recipient to contact. Default: none (mails name only the app and ROOT_URL)
#TS_OPERATOR_NAME=Example Ltd
#TS_SUPPORT_EMAIL=support@example.com
#TS_IMPRINT_URL=https://example.com/imprint

# Name of the company created alongside the first administrator.
#INITIAL_COMPANY_NAME=

# Self sign-up with e-mail and password. Only the literal "true" enables it.
# Off by default: every account that signs up can edit the shared license
# catalog. Default: false
#REGISTRATION_ENABLED=false

# Ask OSV (api.osv.dev) which vulnerabilities affect each component, on every
# analysis. Set to "false" for an air-gapped installation; analysis then uses
# cached and manually entered vulnerabilities only. Default: true
#TS_OSV_ENABLED=true

# Read EPSS exploit-prediction scores from FIRST (api.first.org) when a
# vulnerability report is generated. Set to "false" for an air-gapped
# installation; findings then plot at the report's <0.1% floor. Default: true
#TS_EPSS_ENABLED=true

# Integration URLs (Jira, TFS, webhooks, logos) that point to private, loopback,
# link-local or CGNAT addresses are refused. List the internal hosts an
# installation may reach, comma-separated: host names (jira.corp.local), domain
# suffixes (.corp.local), IP addresses and CIDR ranges (10.20.0.0/16). Cloud
# metadata addresses stay blocked. Default: none
#TS_ALLOWED_PRIVATE_HOSTS=

# Largest file one REST upload (scan, SARIF, import) may send, in MB.
# Default: 50
#TS_UPLOAD_MAX_MB=50

# Vulnerability alerts: a background sweep re-checks approved releases of
# projects that opted in and notifies on new findings. Set TS_VULN_ALERT_SWEEP
# to "false" to turn it off. The interval is in minutes; the two batch sizes
# bound how many projects, and how many releases per project, one pass looks at
# (releases are taken round-robin, so all are covered over several passes).
# Defaults: true, 60, 25, 10
#TS_VULN_ALERT_SWEEP=true
#TS_VULN_ALERT_INTERVAL_MIN=60
#TS_VULN_ALERT_PROJECT_BATCH=25
#TS_VULN_ALERT_RELEASE_BATCH=10

# Verbose debug logging (outbound integration calls, webhooks, workers, security
# guards). Credentials are redacted. Only the literal "true" enables it.
# Default: false
#DEBUG_MODE_ENABLED=false

# Recovery when the only Account admin lost their authenticator: start once with
# the admin's login e-mail here, sign in with the password, then remove it. Other
# users' 2FA is reset by an Account admin in User management. Default: none
#TS_RESET_2FA=

# --- Data from an older installation (optional) -------------------------

# Password of the old, pre-`v2:` encryption scheme. Only needed when the
# database holds integration credentials written by such an installation; they
# stay readable with it. Default: none
#TS_ENCRYPTION_KEY_LEGACY=

# --- Key rotation (optional) --------------------------------------------

# To rotate TS_ENCRYPTION_KEY: move its old value here, set a new
# TS_ENCRYPTION_KEY and start once with TS_REENCRYPT_SECRETS=true. Values written
# with the old key stay readable meanwhile. Keep it set while release signatures
# and published CSAF product ids made with the old key must still verify.
# Default: none
#TS_ENCRYPTION_KEY_PREVIOUS=

# Rewrites stored credentials with TS_ENCRYPTION_KEY on startup: values in the
# pre-`v2:` scheme and values written with TS_ENCRYPTION_KEY_PREVIOUS. "dry" only
# logs what would change, "true" writes. Remove it after the run. Default: none
#TS_REENCRYPT_SECRETS=

# Look for a newer version on startup (the TrustSource update check). Each check
# sends this installation's random id (installationId query parameter) to
# ce.trustsource.io, or to TS_UPDATE_CHECK_URL when set. Set to "false" to turn the
# check off, e.g. for an air-gapped installation or to avoid the outbound call.
# Default: true
#TS_UPDATE_CHECK=true

# Endpoint the version check asks instead; it must answer JSON with
# `latestVersion`, `tag_name` or `version`. Default: the TrustSource update check
#TS_UPDATE_CHECK_URL=

# --- CSAF publishing (optional) ------------------------------------------

# The CSAF provider advisories are published to. One installation publishes to
# one provider. Until all three are set, publishing fails with a message naming
# the ones still missing; everything else in CSAF works.
#TS_CSAF_PROVIDER_URL=https://csaf.example.com/
#TS_CSAF_PROVIDER_PASSPHRASE=
#TS_CSAF_PROVIDER_PASSWORD=
