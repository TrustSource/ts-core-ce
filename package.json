  "devDependencies": {
    "@eslint/compat": "2.0.2",
    "@eslint/js": "10.0.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "chai": "4.5.0",
    "eslint": "10.1.0",
    "eslint-plugin-meteor": "7.3.0",
    "eslint-plugin-sonarjs": "4.0.2",
    "globals": "17.4.0",
    "http-status-codes": "2.3.0",
    "jest": "30.5.2",
    "mongodb": "7.2.0",
    "sinon": "21.0.3",
    "supertest": "7.2.2"
  },
  "scripts": {
    "postinstall": "node tools/patch-node-stubs.js && yarn --cwd workers install --frozen-lockfile",
    "lint": "eslint imports/",
    "lint-fix": "eslint imports/ --fix",
    "roles-overview": "node tools/generate-roles-overview.js",
    "roles-overview:check": "node tools/generate-roles-overview.js --check",
    "lint:sarif": "eslint imports/ -f @microsoft/eslint-formatter-sarif -o reports/eslint.sarif",
    "openapi-validator": "npx --yes -p ibm-openapi-validator lint-openapi -c openapi-config.yaml",
    "openapi-validator:verbose": "npx --yes -p ibm-openapi-validator lint-openapi -c openapi-config-verbose.yaml",
    "meteor-test": "TEST_CLIENT=0 meteor test --once --port 3100 --driver-package meteortesting:mocha",
    "meteor-test:watch": "TEST_CLIENT=0 meteor test --port 3100 --driver-package meteortesting:mocha",
    "meteor-build": "meteor build --server-only --architecture os.linux.x86_64 --directory ../build",
    "test": "jest ./test_api/",
    "test:workers": "yarn --cwd workers test",
    "test:watch": "jest ./test_api/ --watch",
    "test:one": "jest ./test_api/specs/releases.spec.js",
    "test:crypto": "node tools/security/crypto-selftest.cjs",
    "test:ddp": "node tools/security/ddp-validate.mjs",
    "test:regress-auth": "node tools/security/regress-auth.mjs",
    "test:regress-tenant": "node tools/security/regress-tenant.mjs",
    "test:regress-tenant-full": "node tools/security/regress-tenant-full.mjs"
  },
  "resolutions": {
    "underscore": "1.13.8",
    "qs": "6.16.0",
    "tough-cookie": "5.1.2",
    "form-data": "4.0.6",
    "nanoid": "5.1.16",
    "lodash": "4.18.1",
    "bn.js": "5.2.3",
    "axios": "1.20.0",
    "js-yaml": "4.3.2",
    "@babel/core": "7.29.7",
    "moment": "2.31.0",
    "pbkdf2": "3.1.7"
  },
  "author": "EACG GmbH",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": "https://github.com/TrustSource/ts-core-ce",
  "packageManager": "yarn@1.22.22"
}
